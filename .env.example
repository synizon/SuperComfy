# SuperComfy settings. Copy to .env (install.sh does this) — .env is gitignored.

# Password for the ComfyUI web UI (and dashboard). User is always "comfy".
# REQUIRED when exposing to the network (RunPod). Empty = local-only, no auth.
COMFY_AUTH=

# JupyterLab access token. Empty = a random token is generated and printed.
JUPYTER_TOKEN=

# Ports (defaults shown). On RunPod expose these as HTTP ports.
COMFY_PORT=8188
DASHBOARD_PORT=8080
JUPYTER_PORT=8888

# Network bind. Empty = auto: 0.0.0.0 when COMFY_AUTH or RunPod is detected,
# else 127.0.0.1 (local only).
COMFY_BIND_HOST=

# Attention backend: pytorch | sage | flash | comfy-kitchen.
# Empty = run.sh asks once and saves your choice here.
COMFY_ATTENTION=

# 1 = add ComfyUI's --fast optimizations (fp16 accumulation etc.)
COMFY_FAST=

# Extra arguments appended to ComfyUI's command line, e.g. --lowvram
COMFY_EXTRA_ARGS=

# HuggingFace token for gated model downloads (downloadmodels.sh)
HF_TOKEN=

# Start JupyterLab from run.sh (auto-enabled on RunPod). Needs
# SUPERCOMFY_JUPYTER=1 ./install.sh once to install it.
JUPYTER_ENABLE=0

# RunPod volume dir mirrored for durability (set by the pod template)
SUPERCOMFY_VOLUME_DIR=
